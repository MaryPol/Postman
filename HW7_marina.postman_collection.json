							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"// Store response in a variable\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"let cars = pm.iterationData.get(\"cars\");\r",
							"\r",
							"// Extract carId and store it in collection variable\r",
							"pm.collectionVariables.set(\"c_carId\", jsonData.data.id);\r",
							"\r",
