							"});\r",
							"\r",
							"// id\r",
							"pm.test(\"id validation \" + pm.collectionVariables.get(\"c_carId\"), function () {\r",
							"    pm.expect(jsonData.data.id).to.exist;\r",
							"    pm.expect(typeof jsonData.data.id).to.eql(\"number\");\r",
							"    pm.expect(jsonData.data.id).to.eql(pm.collectionVariables.get(\"c_carId\")); \r",
							"});\r",
							"\r",
							"// carBrandId validation\r",
							"pm.test(\"carBrandId validation \"+cars[0].carBrandId , function () {\r",
							"    pm.expect(jsonData.data.carBrandId).to.exist;\r",
							"    pm.expect(typeof jsonData.data.carBrandId).to.eql(\"number\");\r",
							"    pm.expect(Number(jsonData.data.carBrandId)).to.eql(cars[0].carBrandId); \r",
							"});\r",
							"\r",
							"// carModelId validation\r",
							"pm.test(\"carModelId validation \"+ cars[0].carModelId, function () {\r",
							"    pm.expect(jsonData.data.carModelId).to.exist;\r",
							"    pm.expect(typeof jsonData.data.carModelId).to.eql(\"number\");\r",
							"    pm.expect(Number(jsonData.data.carModelId)).to.eql(cars[0].carModelId); \r",
