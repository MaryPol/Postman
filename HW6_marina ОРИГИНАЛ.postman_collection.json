							"var jsonData = pm.response.json();\r",
							"\r",
							"// Extract carId and store it in collection variable\r",
							"pm.collectionVariables.set(\"carId\", jsonData.data.id);\r",
							"\r",
							"// Validate response schema\r",
							"// Status\r",
							"pm.test(\"Status validation\", function () {\r",
							"    pm.expect(jsonData.status).to.eql(\"ok\");\r",
