		{
			"name": "Cars models",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"// проверка ответа\r",
							"var jsonData = pm.response.json();\r",
							"// Проверка статуса ok\r",
							"pm.test(\"Status validation\", function () {\r",
							"    pm.expect(jsonData.status).to.eql(\"ok\");\r",
							"});\r",
							"\r",
							"// проверка что data массив\r",
							"pm.test(\"Data is an array\", function () {\r",
							"    pm.expect(jsonData.data).to.be.an(\"array\");\r",
							"});\r",
							"\r",
							"// Проверка структуры масива data\r",
							"jsonData.data.forEach((item, index) => {\r",
							"    pm.test(`Item ${index + 1} has valid structure`, function () {\r",
							"        pm.expect(item).to.have.property(\"id\").that.is.a(\"number\");\r",
							"        pm.expect(item).to.have.property(\"carBrandId\").that.is.a(\"number\");\r",
							"        pm.expect(item).to.have.property(\"title\").that.is.a(\"string\");\r",
							"    });\r",
							"});\r",
							"\r",
							"\r",
							"//---------------------------------------------------создание переменных\r",
							"// Создаем переменную из респонса\r",
							"var jsonData = pm.response.json().data;\r",
							"let cars = pm.iterationData.get(\"cars\");\r",
							"//console.log(\"что пришло в cars:\", cars);\r",
							"\r",
							"// Получаем carBrandId \r",
							"let brandsName = pm.collectionVariables.get(\"c_brandsName\");\r",
							"//console.log(\"Тип данных brandsName:\", typeof brandsName);\r",
							"//console.log(\"Значение brandsName:\", brandsName);\r",
							"\r",
							"let carBrandId = null; // Переменная для хранения найденного id\r",
							"\r",
							"// Проходим по массиву brandsName\r",
							"brandsName.forEach(brand => {\r",
							"    if (brand.title === cars[0].brand) {\r",
							"        carBrandId = brand.id; // Сохраняем id, если нашли совпадение\r",
							"    }\r",
							"});\r",
							"\r",
							"//console.log(\"что пришло в carBrandId:\",carBrandId);\r",
							"pm.collectionVariables.set(\"c_carBrandId\", carBrandId);\r",
							"\r",
							"// по carBrandId находим carModelId\r",
							"\r",
							"let carModelIds = []; // Массив для хранения id\r",
							"\r",
							"for (let element of jsonData) {\r",
							"    if (element.carBrandId === carBrandId) {\r",
							"        carModelIds.push(element.id); // Добавляем id в массив\r",
							"    }\r",
							"}\r",
							"// Генерируем случайный индекс\r",
							"let randomIndex = Math.floor(Math.random() * carModelIds.length);\r",
							"// Получаем случайное id\r",
							"var randomId =carModelIds[randomIndex];\r",
							"// Устанавливаем переменную коллекции с случайным id\r",
							"pm.collectionVariables.set(\"c_carModelId\", randomId);\r",
							"\r",
							"console.log(\"что пришло в carModelIds:\",carModelIds);\r",
							"console.log(\"что пришло в randomId:\",randomId);\r",
							"\r",
							"\r",
							"// создаем переменную массив modelssName\r",
							"// Создаем массив объектов с полями id и title\r",
							"var modelsName = jsonData.map(item => {\r",
							"    return { id: item.id, title: item.title };\r",
							"});\r",
							"\r",
							"// Устанавливаем переменную коллекции с результатом\r",
							"pm.collectionVariables.set(\"c_modelsName\", modelsName);\r",
							"\r",
							"// Логируем результат для проверки\r",
							"console.log(\"что пришло в modelsName:\",modelsName);\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
