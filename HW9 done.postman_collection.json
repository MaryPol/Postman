		{
			"name": "Cars brands",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();\r",
							"\r",
							"// Проверка статуса 200\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Проверка статуса ok\r",
							"pm.test(\"Status validation\", function () {\r",
							"    pm.expect(jsonData.status).to.eql(\"ok\");\r",
							"});\r",
							"\r",
							"// проверка что data массив\r",
							"pm.test(\"Data is an array\", function () {\r",
							"    pm.expect(jsonData.data).to.be.an(\"array\");\r",
							"});\r",
							"\r",
							"// Проверка структуры масива data\r",
							"jsonData.data.forEach((item, index) => {\r",
							"    pm.test(`Item ${index + 1} has valid structure`, function () {\r",
							"        pm.expect(item).to.have.property(\"id\").that.is.a(\"number\");\r",
							"        pm.expect(item).to.have.property(\"title\").that.is.a(\"string\");\r",
							"        pm.expect(item).to.have.property(\"logoFilename\").that.is.a(\"string\");\r",
							"    });\r",
							"});\r",
							"\r",
							"// Шаг 2: Получаем массив cars из переменных коллекции\r",
							"var cars = pm.collectionVariables.get(\"c_validCars\");\r",
							"\r",
							"// Проходим по каждому элементу в c_cars\r",
							"cars.forEach(car => {\r",
							"    // Ищем соответствующий бренд в ответе API\r",
							"    const brand = jsonData.data.find(brand => brand.id === car.carBrandId);\r",
							"\r",
							"    // Если бренд найден, добавляем его название в объект машины\r",
							"    if (brand) {\r",
							"        car.brandName = brand.title;\r",
							"    }\r",
							"});\r",
							"\r",
							"// Сохраняем обновленную переменную c_cars обратно в коллекцию\r",
							"pm.collectionVariables.set(\"c_validCars\", cars);\r",
							"\r",
							"// Логируем обновленные данные\r",
							"//console.log(\"Updated c_validCars:\", JSON.stringify(cars));\r",
							"let models = pm.collectionVariables.get(\"c_carModels\")\r",
							"// Подсчитываем количество моделей\r",
							"let totalModels = models.length;\r",
							"// Создаем массив объектов brands с полями id и title\r",
							"var brands = jsonData.data.map(item => {\r",
							"    return { id: item.id, brandName: item.title };\r",
							"});\r",
							"\r",
							"// Новый массив для результата\r",
							"let noValidCars = [];\r",
							"\r",
							"// Перебираем каждый бренд\r",
							"brands.forEach(brand => {\r",
							"    // Для каждого бренда добавляем сочетание со всеми моделями\r",
							"    for (let i = 1; i <= totalModels; i++) {\r",
							"        noValidCars.push({\r",
							"            carBrandId: brand.id,\r",
							"            carModelId: i\r",
							"        });\r",
							"    }\r",
							"});\r",
							"// Результат\r",
							"//console.log(\"Total cars:\", noValidCars.length); // 115\r",
							"pm.collectionVariables.set(\"c_noValidCars\", noValidCars);\r",
							"\r",
							"// Процесс добавления полей из массива cars в массив noValidCars\r",
							"noValidCars.forEach(item1 => {\r",
							"    cars.forEach(item2 => {\r",
							"        if (item1.carBrandId === item2.carBrandId && item1.carModelId === item2.carmodelId) {\r",
							"            // Добавляем модель и марку из item2 в item1\r",
							"            item1.modelName = item2.modelName;\r",
							"            item1.brandName = item2.brandName;\r",
							"        }\r",
							"    });\r",
							"});\r",
							"\r",
							"console.log(JSON.stringify(noValidCars));\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
