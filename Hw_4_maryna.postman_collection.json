							"carData.newmileage = carData.mileage + 2;\r",
							"carData.newliters = carData.liters + 10;\r",
							"carData.newtotalCost = 50;\r",
							"\r",
							"// Сохраняем переменные в коллекцию\r",
							"pm.collectionVariables.set(\"c_newmileage\", carData.newmileage);\r",
							"pm.collectionVariables.set(\"c_newliters\", carData.newliters);\r",
							"pm.collectionVariables.set(\"c_newtotalCost\", carData.newtotalCost);\r",
							"pm.collectionVariables.set(\"c_forceMileage\", carData.forceMileage);\r",
							"\r",
							"// Сохраняем обновленный объект c_car_data обратно в коллекцию\r",
							"pm.collectionVariables.set(\"c_car_data\", carData);\r",
							"\r",
