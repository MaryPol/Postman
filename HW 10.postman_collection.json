							"    \"properties\": {\r",
							"        \"status\": {\r",
							"            \"type\": \"string\",\r",
							"            \"enum\": [\"ok\", \"error\"]\r",
							"        }\r",
							"    },\r",
							"    \"required\": [\"status\"]\r",
							"}\r",
							"pm.test(\"Received schema is expected\", function () {\r",
							"    pm.response.to.have.jsonSchema(testSchema);\r",
							"});\r",
							"\r",
							"// --------------------создание проверок для машины\r",
							"pm.test(\"Check if parsedData and CheckCarsData match\", function () {\r",
							"    let parsedData = pm.collectionVariables.get(\"c_parsedData\");\r",
							"    let checkCarsData = pm.collectionVariables.get(\"CheckCarsData\");\r",
							"    var baseURL = pm.collectionVariables.get(\"URL\");\r",
							"\r",
							"    // Проверяем, что baseURL соответствует нужному значению\r",
							"    if (baseURL !== \"https://qauto2.forstudy.space/api\") {\r",
							"        pm.expect.fail(\"URL не соответствует ожидаемому значению для выполнения проверки.\");\r",
							"        return; // Прерываем выполнение теста, если baseURL не совпадает\r",
							"    }\r",
							"\r",
							"    // Проверяем, что parsedData и checkCarsData есть\r",
							"    pm.expect(parsedData).to.be.an('object');\r",
							"    pm.expect(checkCarsData).to.be.an('object');\r",
							"\r",
							"    // Для baseURL === \"https://qauto2.forstudy.space/api\" выбираем данные для user2\r",
							"    let userParsedData = parsedData.user2;  // Используем данные для user2\r",
							"    let userCheckCarsData = checkCarsData.user2CheckCars;\r",
							"\r",
							"    // Проверяем, что массивы для машин пользователя существуют\r",
							"    pm.expect(userParsedData).to.be.an('array', \"Parsed data for user should be an array\");\r",
							"    pm.expect(userCheckCarsData).to.be.an('array', \"CheckCars data for user should be an array\");\r",
							"\r",
							"    // Сравниваем данные для user2\r",
							"    userParsedData.forEach((car, index) => {\r",
							"        let checkCar = userCheckCarsData[index];\r",
							"\r",
							"        pm.test(`CarId match for user at index ${index}`, function () {\r",
							"            pm.expect(checkCar.id).to.eql(car.carId, `Expected CarId: ${car.carId}, but got: ${checkCar.id}`);\r",
							"        });\r",
							"\r",
							"        pm.test(`CarBrandId match for user at index ${index}`, function () {\r",
							"            pm.expect(checkCar.carBrandId).to.eql(car.carBrandId, `Expected CarBrandId: ${car.carBrandId}, but got: ${checkCar.carBrandId}`);\r",
							"        });\r",
							"\r",
							"        pm.test(`CarModelId match for user at index ${index}`, function () {\r",
							"            pm.expect(checkCar.carModelId).to.eql(car.carmodelId, `Expected CarModelId: ${car.carmodelId}, but got: ${checkCar.carModelId}`);\r",
							"        });\r",
							"\r",
							"        // Исправленные проверки\r",
							"        pm.test(`Initial Mileage match for user at index ${index}`, function () {\r",
							"            pm.expect(checkCar.initialMileage).to.eql(car.mileage, `Expected initialMileage: ${car.mileage}, but got: ${checkCar.initialMileage}`);\r",
							"        });\r",
							"\r",
							"        pm.test(`Mileage match for user at index ${index}`, function () {\r",
							"            pm.expect(checkCar.mileage).to.eql(car.newmileage, `Expected mileage: ${car.newmileage}, but got: ${checkCar.mileage}`);\r",
							"        });\r",
							"\r",
							"        pm.test(`Brand match for user at index ${index}`, function () {\r",
							"            pm.expect(checkCar.brand).to.eql(car.brandName, `Expected brand: ${car.brandName}, but got: ${checkCar.brand}`);\r",
							"        });\r",
							"\r",
							"        pm.test(`Model match for user at index ${index}`, function () {\r",
							"            pm.expect(checkCar.model).to.eql(car.modelName, `Expected model: ${car.modelName}, but got: ${checkCar.model}`);\r",
							"        });\r",
							"    });\r",
							"});\r",
							""
