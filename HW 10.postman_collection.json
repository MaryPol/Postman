	"item": [
		{
			"name": "CreateUser",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"//переменная для id user в зависимости от юзера\r",
							"// Получаем JSON-ответ\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"// Получаем значение URL из переменных коллекции\r",
							"var baseURL = pm.collectionVariables.get(\"URL\");\r",
							"\r",
							"// Проверяем URL и устанавливаем переменную соответствующего пользователя\r",
							"if (baseURL === \"https://qauto.forstudy.space/api\") {\r",
							"    pm.collectionVariables.set(\"c_user1Id\", jsonData.data.userId);\r",
							"    console.log(\"Переменная c_user1Id создана:\", jsonData.data.userId);\r",
							"} else if (baseURL === \"https://qauto2.forstudy.space/api\") {\r",
							"    pm.collectionVariables.set(\"c_user2Id\", jsonData.data.userId);\r",
							"    console.log(\"Переменная c_user2Id создана:\", jsonData.data.userId);\r",
							"} else {\r",
							"    console.error(\"URL не соответствует ни одному из ожидаемых значений.\");\r",
							"}\r",
							"//проверки схемы\r",
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"pm.test(\"Check status = ok\", function (){\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.status).to.eql('ok');\r",
							"});\r",
							"var baseURL = pm.collectionVariables.get(\"URL\");\r",
							"var userIdVariable;\r",
							"// проверка юзера в зависимости от урл\r",
							"// Определяем переменную в зависимости от URL\r",
							"if (baseURL === \"https://qauto.forstudy.space/api\") {\r",
							"    userIdVariable = pm.collectionVariables.get(\"c_user1Id\");\r",
							"} else if (baseURL === \"https://qauto2.forstudy.space/api\") {\r",
							"    userIdVariable = pm.collectionVariables.get(\"c_user2Id\");\r",
							"} else {\r",
							"    pm.expect.fail(\"URL не соответствует ни одному из ожидаемых значений.\");\r",
							"}\r",
							"\r",
							"// Теперь можно использовать userIdVariable в названии теста\r",
							"pm.test(\"Check userId based on user \" + userIdVariable , function () { \r",
							"    var jsonData = pm.response.json();\r",
							"\r",
							"    // Выполняем тесты\r",
							"    pm.expect(userIdVariable).to.exist;\r",
							"    pm.expect(jsonData.data.userId).to.exist;\r",
							"    pm.expect(jsonData.data.userId).to.be.above(0);\r",
							"    pm.expect(jsonData.data.userId).to.be.a(\"number\");\r",
							"    pm.expect(jsonData.data.userId).to.eql(userIdVariable);\r",
							"\r",
							"    console.log(\"Проверка выполнена для userId:\", userIdVariable);\r",
							"});\r",
							"\r",
							"pm.test(\"Check photoFilename\", function (){\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.data.photoFilename).to.exist;\r",
							"    pm.expect(jsonData.data.photoFilename).to.be.a(\"string\");\r",
							"});\r",
							"pm.test(\"Check distanceUnits\", function (){\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.data.distanceUnits).to.exist;\r",
							"    pm.expect(jsonData.data.distanceUnits).to.eql('km');\r",
							"});\r",
							"pm.test(\"Check currency\", function (){\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.data.currency).to.exist;\r",
							"    pm.expect(jsonData.data.currency).to.eql('usd');\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Получаем весь JSON-объект из файла\r",
							"let iterationData = pm.iterationData.toObject();\r",
							"\r",
							"// Извлекаем данные пользователя\r",
							"let user = iterationData.user;\r",
							"console.log(user.name);\r",
							"console.log(user.lastName);\r",
							"console.log(user.email);\r",
							"console.log(user.password);\r",
							"\r",
							"// Сохраняем переменные пользователя\r",
							"pm.collectionVariables.set(\"URL\", user.url);\r",
							"pm.collectionVariables.set(\"c_firstName\", user.name);\r",
							"pm.collectionVariables.set(\"c_lastName\", user.lastName);\r",
							"pm.collectionVariables.set(\"c_email\", user.email);\r",
							"pm.collectionVariables.set(\"c_password\", user.password);\r",
							"\r",
							"// Устанавливаем счетчик машин\r",
							"let carsCounter = 0;\r",
							"pm.collectionVariables.set(\"c_carsCounter\", carsCounter);\r",
							"\r",
							"// Извлекаем массив `data` из JSON\r",
							"let data = iterationData.data;\r",
							"\r",
							"// Подготовка структуры для результатов\r",
							"const parsedData = { user1: [], user2: [] };\r",
							"\r",
							"// Перебираем строки в массиве\r",
							"data.forEach(entry => {\r",
							"  const parts = entry.split(' '); // Разделяем строку по пробелам\r",
							"  const user = parts.pop();      // Последний элемент - это пользователь (user1 или user2)\r",
							"  const mileage = parts.pop();   // Предпоследний элемент - пробег автомобиля\r",
							"  const modelName = parts.pop(); // Модель автомобиля\r",
							"  const brandName = parts.join(' '); // Оставшаяся часть - марка автомобиля (может содержать пробелы)\r",
							"\r",
							"  // Создаем объект\r",
							"  const car = { brandName, modelName, mileage: Number(mileage) };\r",
							"\r",
							"  // Добавляем в соответствующий массив\r",
							"  if (user === 'user1') {\r",
							"    parsedData.user1.push(car);\r",
							"  } else if (user === 'user2') {\r",
							"    parsedData.user2.push(car);\r",
							"  }\r",
							"});\r",
							"\r",
							"// Логируем и сохраняем результат\r",
							"console.log(\"parsedData\", JSON.stringify(parsedData));\r",
							"pm.collectionVariables.set(\"c_parsedData\", parsedData);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"name\": \"{{c_firstName}}\",\r\n  \"lastName\": \"{{c_lastName}}\",\r\n  \"email\": \"{{c_email}}\",\r\n  \"password\": \"{{c_password}}\",\r\n  \"repeatPassword\": \"{{c_password}}\"\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{URL}}/auth/signup"
			},
			"response": []
		},
		{
			"name": "Cars models",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// проверка ответа\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"// Проверка статуса ok\r",
							"pm.test(\"Status validation\", function () {\r",
							"    pm.expect(jsonData.status).to.eql(\"ok\");\r",
							"});\r",
							"\r",
							"// проверка что data массив\r",
							"pm.test(\"Data is an array\", function () {\r",
							"    pm.expect(jsonData.data).to.be.an(\"array\");\r",
							"});\r",
							"\r",
							"// Проверка структуры масива data\r",
							"jsonData.data.forEach((item, index) => {\r",
							"    pm.test(`Item ${index + 1} has valid structure`, function () {\r",
							"        pm.expect(item).to.have.property(\"id\").that.is.a(\"number\");\r",
							"        pm.expect(item).to.have.property(\"carBrandId\").that.is.a(\"number\");\r",
							"        pm.expect(item).to.have.property(\"title\").that.is.a(\"string\");\r",
							"    });\r",
							"});\r",
							"\r",
							"// Шаг 1: Получаем ответ\r",
							"var responseData = pm.response.json().data;\r",
							"\r",
							"// создаем переменную массив cars\r",
							"// Создаем массив объектов с полями id и title\r",
							"var carsModels = jsonData.data.map(item => {\r",
							"    return { carmodelId: item.id, carBrandId:item.carBrandId, modelName: item.title};\r",
							"});\r",
							"\r",
							"// Устанавливаем переменную коллекции с результатом\r",
							"//pm.collectionVariables.set(\"c_validCars\", cars);\r",
							"//pm.collectionVariables.set(\"c_carModels\",cars);\r",
							"// Логируем результат для проверки\r",
							"console.log(JSON.stringify(carsModels));\r",
							"pm.collectionVariables.set(\"c_carsModels\", carsModels);\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "accept",
						"value": "application/json"
					}
				],
				"url": "https://qauto2.forstudy.space/api/cars/models"
			},
			"response": []
		},
		{
			"name": "CreateNewCar",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Извлекаем данные из ответа\r",
							"let jsonData = pm.response.json();\r",
							"\r",
							"// Получаем переменные коллекции\r",
							"const modelId = pm.collectionVariables.get(\"c_carModelId\");\r",
							"const brandId = pm.collectionVariables.get(\"c_carBrandId\");\r",
							"const modelName = pm.collectionVariables.get(\"c_modelName\");\r",
							"const brandName = pm.collectionVariables.get(\"c_brandName\");\r",
							"let carsCounter = pm.collectionVariables.get(\"c_carsCounter\");\r",
							"\r",
							"// проверки\r",
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"// Проверка статуса ответа\r",
							"pm.test(\"Status validation\", function () {\r",
							"    pm.expect(jsonData.status).to.eql(\"ok\");\r",
							"});\r",
							"\r",
							"// ------Извлекаем carId из ответа и сохраняем в переменные коллекции\r",
							"// Получаем URL и текущий carsCounter\r",
							"var baseURL = pm.collectionVariables.get(\"URL\");\r",
							"let parsedData = pm.collectionVariables.get(\"c_parsedData\");\r",
							"\r",
							"// Достаем данные из переменных в зависимости от URL\r",
							"let userCars;  // Переменная для машин пользователя\r",
							"// Получаем carId из ответа\r",
							"var carId = jsonData.data.id;\r",
							"// создаем переменную для следующих запросов\r",
							"pm.collectionVariables.set(\"c_carId\", carId);\r",
							"\r",
							"\r",
							"// Определяем, чьи машины обновлять в зависимости от URL\r",
							"if (baseURL === \"https://qauto.forstudy.space/api\") {\r",
							"    userCars = parsedData.user1;  // Используем cars для user1\r",
							"} else if (baseURL === \"https://qauto2.forstudy.space/api\") {\r",
							"    userCars = parsedData.user2;  // Используем cars для user2\r",
							"} else {\r",
							"    pm.expect.fail(\"URL не соответствует ни одному из ожидаемых значений.\");\r",
							"}\r",
							"\r",
							"// Проверка, что индекс carsCounter не выходит за пределы массива\r",
							"if (carsCounter < 5) {\r",
							"    // Получаем текущую машину по carsCounter\r",
							"    var car = userCars[carsCounter];\r",
							"    \r",
							"    // Добавляем carId в объект машины\r",
							"    car.carId = carId;\r",
							"\r",
							"    // Логируем, что carId успешно добавлен\r",
							"    console.log(`Машина с индексом ${carsCounter} обновлена. carId: ${carId}`);\r",
							"\r",
							"    // Обновляем весь массив машин с новым carId\r",
							"    userCars = userCars.map((currentCar, index) => {\r",
							"        if (index === carsCounter) {\r",
							"            return { ...currentCar, carId: carId }; // обновляем carId для нужной машины\r",
							"        }\r",
							"        return currentCar; // оставляем другие машины без изменений\r",
							"    });\r",
							"\r",
							"    // Сохраняем обновленные данные в parsedData\r",
							"    if (baseURL === \"https://qauto.forstudy.space/api\") {\r",
							"        parsedData.user1 = userCars;  // Обновляем для user1\r",
							"    } else if (baseURL === \"https://qauto2.forstudy.space/api\") {\r",
							"        parsedData.user2 = userCars;  // Обновляем для user2\r",
							"    }\r",
							"\r",
							"    // Логируем обновление данных\r",
							"   // console.log(\"Обновленные данные parsedData!!!:\", JSON.stringify(parsedData));\r",
							"\r",
							"    // Сохраняем обновленные parsedData в переменную коллекции\r",
							"    pm.collectionVariables.set(\"c_parsedData\", parsedData);\r",
							"} else {\r",
							"    pm.expect.fail(\"carsCounter превышает количество доступных машин.\");\r",
							"}\r",
							"\r",
							"\r",
							"// -----Проверка id машины\r",
							"if (carsCounter < 5) {\r",
							"    // Получаем carId из текущего объекта машины\r",
							"    var expectedCarId = userCars[carsCounter].carId;\r",
							"\r",
							"    // Выполняем тест проверки id\r",
							"    pm.test(\"id validation = \" + expectedCarId, function () {\r",
							"        // Проверяем, что id из ответа существует и является числом\r",
							"        pm.expect(jsonData.data.id).to.exist;\r",
							"        pm.expect(typeof jsonData.data.id).to.eql(\"number\");\r",
							"\r",
							"        // Сравниваем carId из массива машин с id из ответа\r",
							"        pm.expect(jsonData.data.id).to.eql(expectedCarId);\r",
							"    });\r",
							"}\r",
							"\r",
							"// Проверка carBrandId\r",
							"pm.test(\"carBrandId validation = \" + pm.collectionVariables.get(\"c_carBrandId\"), function () {\r",
							"    pm.expect(jsonData.data.carBrandId).to.exist;\r",
							"    pm.expect(typeof jsonData.data.carBrandId).to.eql(\"number\");\r",
							"    pm.expect(Number(jsonData.data.carBrandId)).to.eql(pm.collectionVariables.get(\"c_carBrandId\"));\r",
							"});\r",
							"\r",
							"// Проверка carModelId\r",
							"pm.test(\"carModelId validation = \" + pm.collectionVariables.get(\"c_carModelId\"), function () {\r",
							"    pm.expect(jsonData.data.carModelId).to.exist;\r",
							"    pm.expect(typeof jsonData.data.carModelId).to.eql(\"number\");\r",
							"    pm.expect(Number(jsonData.data.carModelId)).to.eql(pm.collectionVariables.get(\"c_carModelId\"));\r",
							"});\r",
							"\r",
							"// Проверка initialMileage\r",
							"pm.test(\"initialMileage validation = \" + pm.collectionVariables.get(\"c_mileage\"), function () {\r",
							"    pm.expect(jsonData.data.initialMileage).to.exist;\r",
							"    pm.expect(typeof jsonData.data.initialMileage).to.eql(\"number\");\r",
							"    pm.expect(jsonData.data.initialMileage).to.eql(pm.collectionVariables.get(\"c_mileage\"));\r",
							"});\r",
							"\r",
							"// Проверка updatedMileageAt с текущей датой\r",
							"let today = new Date().toISOString().split('T')[0];\r",
							"pm.test(\"updatedMileageAt contains today's date\", function () {\r",
							"    let updatedDate = jsonData.data.updatedMileageAt.split('T')[0];\r",
							"    pm.expect(updatedDate).to.eql(today);\r",
							"});\r",
							"\r",
							"pm.collectionVariables.set(\"c_updatedMileageAt\", jsonData.data.updatedMileageAt.split('T')[0]);\r",
							"\r",
							"// Проверка carCreatedAt с текущей датой\r",
							"pm.test(\"carCreatedAt contains today's date\", function () {\r",
							"    let createdDate = jsonData.data.carCreatedAt.split('T')[0];\r",
							"    pm.expect(createdDate).to.eql(today);\r",
							"});\r",
							"\r",
							"pm.collectionVariables.set(\"c_carCreatedAt\", jsonData.data.carCreatedAt.split('T')[0]);\r",
							"\r",
							"// Проверка mileage\r",
							"pm.test(\"mileage validation = \" + pm.collectionVariables.get(\"c_mileage\"), function () {\r",
							"    pm.expect(jsonData.data.mileage).to.exist;\r",
							"    pm.expect(typeof jsonData.data.mileage).to.eql(\"number\");\r",
							"    pm.expect(jsonData.data.mileage).to.eql(pm.collectionVariables.get(\"c_mileage\"));\r",
							"});\r",
							"\r",
							"// Проверка brand\r",
							"pm.test(\"brand validation = \" + pm.collectionVariables.get(\"c_brandName\"), function () {\r",
							"    pm.expect(jsonData.data.brand).to.exist;\r",
							"    pm.expect(typeof jsonData.data.brand).to.eql(\"string\");\r",
							"    pm.expect(jsonData.data.brand).to.eql(pm.collectionVariables.get(\"c_brandName\"));\r",
							"});\r",
							"\r",
							"// Проверка model\r",
							"pm.test(\"model validation = \" + pm.collectionVariables.get(\"c_modelName\"), function () {\r",
							"    pm.expect(jsonData.data.model).to.exist;\r",
							"    pm.expect(typeof jsonData.data.model).to.eql(\"string\");\r",
							"    pm.expect(jsonData.data.model).to.eql(pm.collectionVariables.get(\"c_modelName\"));\r",
							"});\r",
							"\r",
							"// Проверка logo\r",
							"pm.test(\"logo validation\", function () {\r",
							"    pm.expect(jsonData.data.logo).to.exist;\r",
							"    pm.expect(typeof jsonData.data.logo).to.eql(\"string\");\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let carsModels = pm.collectionVariables.get(\"c_carsModels\");\r",
							"let parsedData = pm.collectionVariables.get(\"c_parsedData\");\r",
							"\r",
							"// Достаем данные из переменных в зависимости от URL\r",
							"let userCars;  // Переменная для машин пользователя\r",
							"let carsCounter = pm.collectionVariables.get(\"c_carsCounter\");  // Получаем или инициализируем carsCounter\r",
							"var baseURL = pm.collectionVariables.get(\"URL\");\r",
							"\r",
							"// Функция для обновления parsedData с carmodelId и carBrandId\r",
							"Object.keys(parsedData).forEach(user => {\r",
							"    parsedData[user] = parsedData[user].map(car => {\r",
							"        const matchedModel = carsModels.find(model => model.modelName === car.modelName);\r",
							"        if (matchedModel) {\r",
							"            return {\r",
							"                ...car,\r",
							"                carmodelId: matchedModel.carmodelId,\r",
							"                carBrandId: matchedModel.carBrandId\r",
							"            };\r",
							"        }\r",
							"        return car; // Если совпадений нет, возвращаем исходный объект\r",
							"    });\r",
							"});\r",
							"\r",
							"console.log(\"parsedData\", JSON.stringify(parsedData));\r",
							"pm.collectionVariables.set(\"c_parsedData\", parsedData);\r",
							"\r",
							"// Определяем, чьи машины создавать в зависимости от URL\r",
							"if (baseURL === \"https://qauto.forstudy.space/api\") {\r",
							"    userCars = parsedData.user1;  // Используем cars для user1\r",
							"    console.log(\"userCars\", userCars);\r",
							"    console.log(\"userCars length\", userCars.length);\r",
							"} else if (baseURL === \"https://qauto2.forstudy.space/api\") {\r",
