							"let carsCounter = pm.collectionVariables.get(\"c_carsCounter\");\r",
							"\r",
							"// Проверяем, что счетчик находится в пределах массива\r",
							"if (carsCounter < cars.length) {\r",
							"    // Получаем текущий объект машины\r",
