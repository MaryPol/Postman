							"const min = 1000;\r",
							"const max = 100000;\r",
							"let randomMileage = Math.floor(Math.random() * (max - min + 1)) + min;\r",
							"let initialMileage = randomMileage;\r",
							"\r",
							"//---------обнулить счетчик----------\r",
							"let expensCounter = 0;\r",
							"pm.collectionVariables.set(\"c_expensCounter\", expensCounter);\r",
							"\r",
							"//console.log(randomMileage);\r",
							"//-----------------------------для дебага---------------------------------\r",
							"pm.collectionVariables.set(\"c_mileage\", randomMileage);\r",
							"console.log(\"mileage\",pm.collectionVariables.get(\"c_mileage\"));\r",
							"pm.collectionVariables.set(\"c_initialMileage\", initialMileage);\r",
							"console.log(\"initialMileage\",pm.collectionVariables.get(\"c_initialMileage\"));\r",
							"// НАШ ЦИКЛ СОЗДАНИЯ МАШИН\r",
							"//console.log(cars.length-1);\r",
							"// Проверяем длину массива\r",
							"if (carsCounter < cars.length-1) { //0 < 23, то есть как раз до 22.\r",
							"    // Увеличиваем счетчик после выполнения запроса\r",
							"    carsCounter = carsCounter + 1;\r",
							"    console.log(\"------------carsCounter----------------: \", carsCounter);\r",
