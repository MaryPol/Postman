							"\r",
							"let mileage = pm.collectionVariables.get(\"c_mileage\");\r",
							"let increment = cars.increment;\r",
							"let newmileage = increment + mileage;\r",
							"console.log(\"newmileage\", newmileage);\r",
							"pm.collectionVariables.set(\"c_mileage\", newmileage);\r",
							"\r",
							"// создать liters\r",
							"const min = 0.01;\r",
							"const max = 9999;\r",
							"let randomLiters = Math.floor(Math.random() * (max - min + 1)) + min;\r",
							"\r",
							"//console.log(randomLiters);\r",
							"\r",
							"pm.collectionVariables.set(\"c_liters\", randomLiters);\r",
							"\r",
							"// создать totalCost\r",
